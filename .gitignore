# HDC ERP — never commit databases, backups, archives, secrets or envs
hdc_instance/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.zip
*.bak
backups/
attached_assets/

# Local env (contains DB path / admin bootstrap password)
.env

# GitHub hook credentials generated by ops/pythonanywhere/setup.py (+ backups)
github_hook_credentials.txt*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / shell dotfiles that came out of the zip (not app code)
.bashrc
.profile
.vimrc
.gitconfig
.pythonstartup.py
README.txt
.cache/
.local/
.ipython/
.virtualenvs/

# Misc
node_modules/
.DS_Store
*.log
instance/
deploy_secret.txt
