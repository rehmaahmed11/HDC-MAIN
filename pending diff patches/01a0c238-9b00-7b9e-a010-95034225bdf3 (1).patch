+.dir-btn i { font-size: 1.3rem; display: block; margin-bottom: 4px; }
+.dir-btn .lbl { font-weight: 700; font-size: 0.85rem; }
+.dir-btn .desc { font-size: 0.68rem; color: #64748b; }
+
+.type-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 8px; }
+.type-btn {
+  border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px;
+  text-align: left; cursor: pointer; transition: all 0.15s;
+  background: #fff; display: flex; gap: 10px; align-items: flex-start;
+}
+.type-btn:hover { border-color: #94a3b8; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
+.type-btn.active { border-color: var(--flow-color, #10b981); background: var(--flow-bg, #ecfdf5); box-shadow: 0 2px 12px rgba(16,185,129,0.15); }
+.type-btn i { margin-top: 2px; }
+.type-btn .t-title { font-weight: 700; font-size: 0.82rem; }
+.type-btn .t-desc { font-size: 0.7rem; color: #64748b; line-height: 1.3; }
+
+.balance-hint { font-size: 0.78rem; padding: 6px 10px; border-radius: 8px; margin-top: 6px; }
+.balance-hint.pos { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
+.balance-hint.neg { background: #fff1f2; color: #881337; border: 1px solid #fecdd3; }
+.balance-hint.warn { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
+
+.pending-hint {
+  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
+  border: 1px solid #e2e8f0; border-radius: 10px;
+  padding: 10px 12px; font-size: 0.82rem;
+}
+.pending-hint .ph-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; }
+.pending-hint .ph-value { font-weight: 800; font-size: 1.1rem; margin-top: 2px; }
+.pending-hint .ph-breakdown { font-size: 0.75rem; color: #64748b; margin-top: 4px; }
+
+.recon-alert { border-radius: 12px; padding: 12px 16px; display: flex; gap: 12px; align-items: flex-start; }
+.recon-alert.ok { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
+.recon-alert.warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
+.recon-alert.danger { background: #fff1f2; border: 1px solid #fecdd3; color: #881337; }
+
+.txn-timeline-item {
+  display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9;
+  font-size: 0.82rem;
+}
+.txn-timeline-item:last-child { border-bottom: none; }
+.txn-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
+.txn-dot.in { background: #10b981; }
+.txn-dot.out { background: #f43f5e; }
+.txn-dot.transfer { background: #3b82f6; }
+
+@media (max-width: 768px) {
+  .direction-selector { grid-template-columns: 1fr; }
+  .type-grid { grid-template-columns: 1fr; }
+}
