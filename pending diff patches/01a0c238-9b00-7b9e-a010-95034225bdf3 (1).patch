+  padding: 12px;
+  background: var(--card-bg, #fff);
+  margin-bottom: 10px;
+}
+.pending-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
+.pending-title { font-weight: 700; font-size: 0.88rem; }
+.pending-total { font-weight: 800; font-size: 0.92rem; }
+.pending-item {
+  display: flex; justify-content: space-between; align-items: center;
+  padding: 6px 8px; border-radius: 8px;
+  font-size: 0.8rem;
+}
+.pending-item:hover { background: #f8fafc; }
+.pending-item .name { font-weight: 600; }
+.pending-item .code { font-size: 0.7rem; color: #94a3b8; }
+.pending-item .amt { font-weight: 700; }
+.pending-item .amt.pos { color: #059669; }
+.pending-item .amt.neg { color: #e11d48; }
+
