+.flow-badge.in { background: #ecfdf5; border-color: #a7f3d0; color: #065f46; }
+.flow-badge.out { background: #fff1f2; border-color: #fecdd3; color: #881337; }
+.flow-badge.transfer { background: #eff6ff; border-color: #bfdbfe; color: #1e40af; }
+.flow-posting { font-size: 0.72rem; color: #475569; background: #f8fafc; border-radius: 8px; padding: 8px; margin-bottom: 8px; border: 1px dashed #e2e8f0; }
+.flow-actions { display: flex; gap: 6px; flex-wrap: wrap; }
