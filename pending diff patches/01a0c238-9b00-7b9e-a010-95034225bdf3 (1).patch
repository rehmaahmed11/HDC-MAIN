+.flow-desc { font-size: 0.78rem; color: #64748b; line-height: 1.5; margin-bottom: 8px; }
+.flow-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
+.flow-badge {
+  font-size: 0.68rem; padding: 2px 7px; border-radius: 20px;
+  background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;
