# Copy this file OUTSIDE the Git repository, for example:
#   /home/yourname/.config/hdc/production.env
# Then replace every placeholder and chmod 600 the real file.

HDC_ENV=prod
HDC_SECRET_KEY=replace-with-a-long-random-secret
HDC_DB_PATH=/home/yourname/HDC_INSTANCE/hdc_erp.db
HDC_INSTANCE_DIR=/home/yourname/HDC_INSTANCE

# Required only when the database has no users yet.
HDC_BOOTSTRAP_ADMIN_USERNAME=admin
HDC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Deployment settings.
HDC_APP_DIR=/home/yourname/HDC-MAIN
HDC_VENV_PATH=/home/yourname/.virtualenvs/hdc
HDC_DEPLOY_BRANCH=main
HDC_BACKUP_DIR=/home/yourname/HDC_INSTANCE/backups/deployments

# Optional: touch this file to request a PythonAnywhere reload after success.
# Leave blank and click Reload manually if preferred.
HDC_WSGI_FILE=/var/www/yourname_pythonanywhere_com_wsgi.py

# Keep this 0 when an existing production DB is expected.
# Set to 1 only for an intentional first deployment with a new empty DB.
HDC_ALLOW_NEW_DB=0

# ---------------------------------------------------------------------------
# Webhook auto-deploy (deploy_receiver.py mounted at /deploy/*).
# ---------------------------------------------------------------------------

# Generate one and put the SAME value in GitHub -> Settings -> Webhooks ->
#   Secret:  python3 -c "import secrets; print(secrets.token_hex(32))"
HDC_DEPLOY_WEBHOOK_SECRET=replace-with-the-same-random-secret

# Only pushes to this repository/branch are deployed.  The repo check stops a
# webhook that was copied to a fork from deploying this account.
HDC_DEPLOY_REPO=rehmaahmed11/HDC-MAIN

# Optional bearer token for GET /deploy/status and POST /deploy/trigger.
# Leave HDC_DEPLOY_ALLOW_MANUAL=0 unless you want the manual/rollback trigger.
HDC_DEPLOY_TOKEN=
HDC_DEPLOY_ALLOW_MANUAL=0

# Where the receiver writes deploy.log and deploy_state.json.  Defaults to
# $HDC_INSTANCE_DIR/deploy, which is outside Git's control either way.
# HDC_DEPLOY_STATE_DIR=/home/yourname/HDC_INSTANCE/deploy

# Set to 1 for an emergency stop: /deploy/* answers "disabled" and no push is
# deployed, while the ERP itself keeps running normally.
HDC_DEPLOY_DISABLED=0
